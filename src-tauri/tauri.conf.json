{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Producer",
  "version": "0.4.3",
  "identifier": "ai.boomin.producer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Producer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0d13"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMzFFMjYwNDVEQzM4ODIKUldTQ09OeEZZT0l4YXBVZVloK2hYVDhLUk4vdHQ1S29Cd0JOR2ErTlBOaGtraWtpMFg4RW1adGYK",
      "endpoints": [
        "https://github.com/Boomin-Ai/producer/releases/latest/download/latest.json"
      ]
    }
  }
}
