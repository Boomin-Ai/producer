              "text": "IS CURRENCY",
              "styles": {
                "position": "absolute",
                "left": 1020,
                "top": 96,
                "width": 750,
                "height": 76,
                "fontSize": 54,
                "fontWeight": 700,
                "color": "#f4f4f2"
