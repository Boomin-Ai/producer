{
  "schema": "producer.presentation/2",
  "id": "attention-signal",
  "version": "1.0.1",
  "name": "Attention Is Currency · Signal",
  "set": {
    "initialLayout": "landscape",
    "values": {
      "topic": {
        "type": "text",
        "default": "THE COST OF ATTENTION",
        "maxLength": 60
      },
      "host": {
        "type": "text",
        "default": "KLEVELAND",
        "maxLength": 40
      },
      "sensitivity": {
        "type": "number",
        "default": 0.85,
        "min": 0,
        "max": 2
      },
      "motion": {
        "type": "number",
        "default": 0.6,
        "min": 0,
        "max": 4
      }
    },
    "feeds": {},
    "slots": [
      {
        "id": "host",
        "label": "Host camera"
      }
    ],
    "components": {},
    "controls": [
      {
        "id": "topic",
        "type": "text",
        "label": "Topic headline",
        "key": "topic"
      },
      {
        "id": "host",
        "type": "text",
        "label": "Host name",
        "key": "host"
      },
      {
        "id": "sensitivity",
        "type": "number",
        "label": "Sensitivity",
        "key": "sensitivity"
      },
      {
        "id": "motion",
        "type": "number",
        "label": "Motion",
        "key": "motion"
      },
      {
        "id": "landscape",
        "type": "button",
        "label": "Cover · Landscape",
        "action": {
          "type": "layout.select",
          "layoutId": "landscape"
        }
      },
      {
        "id": "portrait",
        "type": "button",
        "label": "Cover · Portrait",
        "action": {
          "type": "layout.select",
          "layoutId": "portrait"
        }
      }
    ],
    "controlArrangement": {
      "sections": [
        {
          "id": "editorial",
          "label": "On the cover",
          "controls": [
            "set:topic",
            "set:host"
          ]
        },
        {
          "id": "signal",
          "label": "Voice motion",
          "controls": [
            "set:sensitivity",
            "set:motion"
          ]
        },
        {
          "id": "format",
          "label": "Format",
          "controls": [
            "set:landscape",
            "set:portrait"
          ]
        }
      ],
      "minimized": [
        "set:topic",
        "set:landscape",
        "set:portrait"
      ]
    },
    "layouts": [
      {
        "id": "landscape",
        "label": "Cover · Landscape",
        "width": 1920,
        "height": 1080,
        "root": {
          "id": "cover",
          "type": "box",
          "styles": {
            "position": "relative",
            "width": 1920,
            "height": 1080,
            "background": "#0b0b0c",
            "overflow": "hidden"
          },
          "children": [
            {
              "id": "voice-contour",
              "type": "shader",
              "styles": {
                "position": "absolute",
                "left": 70,
                "top": 175,
                "width": 830,
                "height": 830
              },
              "shader": {
                "effect": "voiceRing",
                "variant": 15,
                "colors": [
                  "#f4f4f2",
                  "#f4f4f2",
                  "#f4f4f2"
                ],
                "speed": 0.6,
                "intensity": 0.85,
                "scale": 0.4,
                "opacity": 1,
                "radius": 325,
                "quality": "medium",
                "clock": "show",
                "glow": 0,
                "bindings": {
                  "intensity": {
                    "get": "values.sensitivity"
                  },
                  "speed": {
                    "get": "values.motion"
                  }
                }
              }
            },
            {
              "id": "masthead",
              "type": "text",
              "text": "ATTN",
              "styles": {
                "position": "absolute",
                "left": 78,
                "top": 30,
                "width": 830,
                "height": 205,
                "fontSize": 180,
                "fontWeight": 800,
                "color": "#f4f4f2"
              }
            },
            {
              "id": "brand",
