                "top": 620,
                "width": 1160,
                "height": 59,
                "background": "#0c151eea",
                "borderRadius": "12px",
                "border": "1px solid #ffffff24",
                "display": "flex",
                "alignItems": "center",
                "gap": "18px",
                "padding": "0 20px"
              },
              "children": [
                {
                  "id": "ticker-tag",
                  "type": "text",
                  "text": "MATCHUP",
                  "styles": {
                    "fontSize": "12px",
                    "fontWeight": 800,
                    "letterSpacing": ".13em",
                    "color": "#fa9560"
                  }
