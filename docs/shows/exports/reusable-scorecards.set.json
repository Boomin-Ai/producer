{
  "schema": "producer.presentation/1",
  "id": "reusable-scorecards",
  "version": "0.1.1",
  "name": "Reusable Components \u00b7 Scorecards",
  "set": {
    "initialLayout": "slate",
    "values": {
      "clock": {
        "type": "text",
        "default": "15:00",
        "maxLength": 8
      },
      "period": {
        "type": "text",
        "default": "Q1",
        "maxLength": 16
      },
      "down": {
        "type": "text",
        "default": "1st & 10",
        "maxLength": 22
      },
      "possession": {
        "type": "text",
        "default": "POSSESSION \u00b7 RAIDERS",
        "maxLength": 34
      },
      "field": {
        "type": "text",
        "default": "BALL ON LV 25",
        "maxLength": 28
      },
      "headline": {
        "type": "text",
        "default": "Raiders vs. Dolphins \u2014 your game-day desk.",
        "maxLength": 90
      },
      "raidersScore": {
        "type": "number",
        "default": 0,
        "min": 0,
        "max": 199
      },
      "dolphinsScore": {
        "type": "number",
        "default": 0,
        "min": 0,
        "max": 199
      }
    },
    "feeds": {},
    "slots": [
      {
        "id": "background",
        "label": "Background video"
      }
    ],
    "components": {
      "ScoreCard": {
        "props": {
          "name": "Team",
          "city": "City",
          "score": 0,
          "accent": "#ffffff"
        },
        "root": {
          "id": "scorecard-root",
          "type": "box",
          "styles": {
            "position": "relative",
            "width": "100%",
            "height": "100%"
          },
          "children": [
            {
              "id": "accent-stripe",
              "type": "box",
              "styles": {
                "position": "absolute",
                "left": 0,
                "top": 0,
                "width": 416,
                "height": 5,
                "background": {
                  "get": "props.accent"
                }
              },
              "children": []
            },
            {
              "id": "team-name",
              "type": "text",
              "text": {
                "get": "props.name"
              },
              "styles": {
                "position": "absolute",
                "left": 22,
                "top": 21,
                "width": 198,
                "height": 44,
                "fontSize": "29px",
                "fontWeight": 850,
                "letterSpacing": ".025em",
                "color": "#f4f5f7"
              }
            },
            {
              "id": "team-city",
              "type": "text",
              "text": {
                "get": "props.city"
              },
              "styles": {
                "position": "absolute",
                "left": 24,
                "top": 70,
                "width": 264,
                "height": 25,
                "fontSize": "12px",
                "letterSpacing": ".22em",
                "color": {
                  "get": "props.accent"
                }
              }
            },
            {
              "id": "team-score",
              "type": "text",
              "text": {
                "get": "props.score"
              },
              "styles": {
                "position": "absolute",
                "left": 228,
                "top": 13,
                "width": 164,
                "height": 91,
                "fontSize": "76px",
                "fontWeight": 850,
                "textAlign": "right",
                "color": {
                  "get": "props.accent"
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "id": "overlay",
        "label": "Game Overlay",
        "width": 1280,
        "height": 720,
        "root": {
          "id": "overlay-root",
          "type": "box",
          "styles": {
            "position": "relative",
            "width": "100%",
            "height": "100%",
            "overflow": "hidden",
            "background": "#081019"
          },
          "children": [
            {
              "id": "room-video",
              "type": "slot",
              "slotId": "background",
              "styles": {
                "position": "absolute",
                "left": 0,
                "top": 0,
                "width": 1280,
                "height": 720
              },
              "framing": {
                "mode": "fill",
                "x": 0.5,
                "y": 0.5
              }
            },
            {
              "id": "scoreboard",
              "type": "box",
              "styles": {
                "position": "absolute",
                "left": 60,
                "top": 38,
                "width": 1160,
                "height": 172,
                "background": "linear-gradient(120deg,#11151cf5,#17232af5)",
                "border": "1px solid #ffffff24",
                "borderRadius": "18px",
                "boxShadow": "0 12px 35px #00000044"
              },
              "children": [
                {
                  "id": "raiders-team",
                  "type": "component",
                  "component": "ScoreCard",
                  "styles": {
                    "position": "absolute",
                    "left": 0,
                    "top": 50,
                    "width": 416,
                    "height": 126
                  },
                  "props": {
                    "name": "RAIDERS",
                    "city": "LAS VEGAS",
                    "score": {
                      "get": "values.raidersScore"
                    },
                    "accent": "#bec4cd"
                  }
                },
                {
                  "id": "dolphins-team",
                  "type": "component",
                  "component": "ScoreCard",
                  "styles": {
                    "position": "absolute",
                    "left": 744,
                    "top": 50,
                    "width": 416,
                    "height": 126
                  },
                  "props": {
                    "name": "DOLPHINS",
                    "city": "MIAMI",
                    "score": {
                      "get": "values.dolphinsScore"
                    },
                    "accent": "#32c6cb"
                  }
                },
                {
                  "id": "middle",
                  "type": "box",
                  "styles": {
                    "position": "absolute",
                    "left": 431,
                    "top": 26,
                    "width": 298,
                    "height": 122,
                    "background": "#080e15",
                    "borderRadius": "12px"
                  },
                  "children": [
                    {
                      "id": "matchup",
                      "type": "text",
                      "text": "LAS VEGAS \u00d7 MIAMI",
                      "styles": {
                        "position": "absolute",
                        "left": 15,
                        "top": 12,
                        "width": 268,
                        "height": 22,
                        "fontSize": "12px",
                        "letterSpacing": ".16em",
                        "textAlign": "center",
                        "color": "#aab7c4"
                      }
                    },
                    {
                      "id": "clock",
                      "type": "text",
                      "text": {
                        "get": "values.clock"
                      },
                      "styles": {
                        "position": "absolute",
                        "left": 15,
                        "top": 38,
                        "width": 268,
                        "height": 50,
                        "fontSize": "42px",
                        "fontWeight": 800,
                        "textAlign": "center",
                        "color": "#f7f3eb"
                      }
                    },
                    {
                      "id": "period",
                      "type": "text",
                      "text": {
                        "get": "values.period"
                      },
                      "styles": {
                        "position": "absolute",
                        "left": 15,
                        "top": 91,
                        "width": 268,
                        "height": 20,
                        "fontSize": "13px",
                        "textAlign": "center",
                        "color": "#fa9560",
                        "letterSpacing": ".13em"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "game-status",
              "type": "box",
              "styles": {
                "position": "absolute",
                "left": 60,
                "top": 226,
                "width": 1160,
                "height": 44,
                "background": "#0a121be8",
                "border": "1px solid #ffffff1a",
                "borderRadius": "10px",
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "space-between",
                "padding": "0 20px"
              },
              "children": [
                {
                  "id": "down",
                  "type": "text",
                  "text": {
                    "get": "values.down"
                  },
                  "styles": {
                    "fontSize": "17px",
                    "fontWeight": 650,
                    "color": "#f2f3f5"
