          "tag": "button",
          "attributes": {
            "type": "button",
            "disabled": {
              "op": "call",
              "fn": "not",
              "args": [
                {
                  "op": "get",
                  "path": [
                    "capabilities",
                    "actions",
                    "episode.pause"
                  ]
                }
              ]
            }
          },
          "styles": {
            "padding": "12px 18px",
            "borderRadius": "12px",
            "background": "#a8ffce",
            "color": "#07121a",
            "fontWeight": 700
          },
          "events": {
            "click": {
              "action": "episode.pause"
            }
          },
          "children": [
            {
              "id": "mod-pause-label",
              "kind": "text",
              "text": "Pause round"
            }
          ]
        }
      ]
    }
  },
