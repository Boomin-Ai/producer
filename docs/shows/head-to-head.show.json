            "x": 0.04,
            "y": 0.19,
            "width": 0.44,
            "height": 0.65
          },
          "z": 10,
          "visible": true,
          "fit": "contain"
        },
        {
          "slotId": "right",
          "rect": {
            "x": 0.52,
            "y": 0.19,
            "width": 0.44,
            "height": 0.65
          },
          "z": 11,
          "visible": true,
          "fit": "contain"
        }
      ],
      "background": {
