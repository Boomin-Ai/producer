                "keyframes": [
                  {
                    "offset": 0,
                    "styles": {
                      "opacity": 0.45
                    }
                  },
                  {
                    "offset": 0.5,
                    "styles": {
                      "opacity": 1
                    }
                  },
                  {
                    "offset": 1,
                    "styles": {
                      "opacity": 0.45
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "duel-result",
            "kind": "element",
            "tag": "div",
            "when": {
