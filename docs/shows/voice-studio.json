{
  "schema": "producer.presentation/2",
  "id": "voice-studio",
  "version": "1.2.0",
  "name": "Voice Studio",
  "set": {
    "initialLayout": "landscape",
    "values": {
      "title": {
        "type": "text",
        "default": "VOICE / STUDIO",
        "maxLength": 60
      },
      "sensitivity": {
        "type": "number",
        "default": 1.5,
        "min": 0,
        "max": 2
      },
      "motion": {
        "type": "number",
        "default": 1.6,
        "min": 0,
        "max": 4
      },
      "glow": {
        "type": "number",
        "default": 0.65,
        "min": 0,
        "max": 1
      }
    },
    "feeds": {},
    "slots": [
      {
        "id": "host",
        "label": "Host camera"
      }
    ],
    "components": {},
    "controls": [
      {
        "id": "title",
        "type": "text",
        "label": "Title",
        "key": "title"
      },
      {
        "id": "landscape",
        "type": "button",
        "label": "Landscape",
        "action": {
          "type": "layout.select",
          "layoutId": "landscape"
        }
      },
      {
        "id": "portrait",
        "type": "button",
        "label": "Portrait",
        "action": {
          "type": "layout.select",
          "layoutId": "portrait"
        }
      },
      {
        "id": "sensitivity",
        "type": "number",
        "label": "Sensitivity",
        "key": "sensitivity"
      },
      {
        "id": "motion",
        "type": "number",
        "label": "Motion",
        "key": "motion"
      },
      {
        "id": "glow",
        "type": "number",
        "label": "Glow",
        "key": "glow"
      }
    ],
    "controlArrangement": {
      "sections": [
        {
          "id": "content",
          "label": "Content",
          "controls": [
            "set:title"
          ]
        },
        {
          "id": "visuals",
          "label": "Voice visuals",
          "controls": [
            "set:sensitivity",
            "set:motion",
            "set:glow"
          ]
        },
        {
          "id": "layout",
          "label": "Layout",
          "controls": [
            "set:landscape",
            "set:portrait"
          ]
        }
      ],
      "minimized": [
        "set:sensitivity",
        "set:motion",
        "set:glow",
        "set:landscape",
        "set:portrait"
      ]
    },
    "layouts": [
      {
        "id": "landscape",
        "label": "Center Stage \u00b7 Landscape",
        "width": 1920,
        "height": 1080,
        "root": {
          "id": "studio-root",
          "type": "box",
          "styles": {
            "position": "relative",
            "width": 1920,
            "height": 1080,
            "background": "#080d17",
            "overflow": "hidden"
          },
          "children": [
            {
              "id": "voice-level",
              "type": "shader",
              "styles": {
                "position": "absolute",
                "left": 545.0,
                "top": 145,
                "width": 830,
                "height": 830
              },
              "shader": {
                "effect": "voiceRing",
                "colors": [
                  "#142b3d",
                  "#62e5d5",
                  "#c5b2ff"
                ],
                "speed": 1.6,
                "intensity": 1.5,
                "scale": 1,
                "opacity": 1,
                "radius": 325.0,
                "quality": "medium",
                "clock": "show",
                "glow": 0.65,
                "bindings": {
                  "intensity": {
                    "get": "values.sensitivity"
                  },
                  "speed": {
                    "get": "values.motion"
                  },
                  "glow": {
                    "get": "values.glow"
                  }
                }
              }
            },
            {
              "id": "title",
              "type": "text",
              "text": {
                "get": "values.title"
              },
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 35,
                "width": 1776,
                "height": 80,
                "fontSize": 58,
                "fontWeight": 600,
                "color": "#edf2f7",
                "textAlign": "center"
              }
            },
            {
              "id": "host-camera",
              "type": "slot",
              "slotId": "host",
              "styles": {
                "position": "absolute",
                "left": 635.0,
                "top": 235,
                "width": 650,
                "height": 650
              },
              "framing": {
                "mode": "fill",
                "x": 0.5,
                "y": 0.5
              },
              "appearance": {
                "shape": "circle",
                "cornerRadius": 28,
                "outlineWidth": 0,
                "outlineColor": "#62e5d5",
                "grayscale": 0,
                "opacity": 1
              }
            },
            {
              "id": "voice-subtitle",
              "type": "text",
              "text": "CENTER STAGE",
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 1005,
                "width": 1776,
                "height": 55,
                "fontSize": 24,
                "fontWeight": 600,
                "color": "#62e5d5",
                "textAlign": "center"
              }
            }
          ]
        }
      },
      {
        "id": "portrait",
        "label": "Center Stage \u00b7 Portrait",
        "width": 1080,
        "height": 1920,
        "root": {
          "id": "studio-root",
          "type": "box",
          "styles": {
            "position": "relative",
            "width": 1080,
            "height": 1920,
            "background": "#080d17",
            "overflow": "hidden"
          },
          "children": [
            {
              "id": "voice-level",
              "type": "shader",
              "styles": {
                "position": "absolute",
                "left": 120.0,
                "top": 520,
                "width": 840,
                "height": 840
              },
              "shader": {
                "effect": "voiceRing",
                "colors": [
                  "#142b3d",
                  "#62e5d5",
                  "#c5b2ff"
                ],
                "speed": 1.6,
                "intensity": 1.5,
                "scale": 1,
                "opacity": 1,
                "radius": 330.0,
                "quality": "medium",
                "clock": "show",
                "glow": 0.65,
                "bindings": {
                  "intensity": {
                    "get": "values.sensitivity"
                  },
                  "speed": {
                    "get": "values.motion"
                  },
                  "glow": {
                    "get": "values.glow"
                  }
                }
              }
            },
            {
              "id": "title",
              "type": "text",
              "text": {
                "get": "values.title"
              },
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 130,
                "width": 936,
                "height": 110,
                "fontSize": 62,
                "fontWeight": 600,
                "color": "#edf2f7",
                "textAlign": "center"
              }
            },
            {
              "id": "host-camera",
              "type": "slot",
              "slotId": "host",
              "styles": {
                "position": "absolute",
                "left": 210.0,
                "top": 610,
                "width": 660,
                "height": 660
              },
              "framing": {
                "mode": "fill",
                "x": 0.5,
                "y": 0.5
              },
              "appearance": {
                "shape": "circle",
                "cornerRadius": 28,
                "outlineWidth": 0,
                "outlineColor": "#62e5d5",
                "grayscale": 0,
                "opacity": 1
              }
            },
            {
              "id": "voice-subtitle",
              "type": "text",
              "text": "CENTER STAGE",
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 1430,
                "width": 936,
                "height": 65,
                "fontSize": 28,
                "fontWeight": 600,
                "color": "#62e5d5",
                "textAlign": "center"
              }
            },
            {
              "id": "voice-description",
              "type": "text",
              "text": "Your voice. In motion.",
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 1510,
                "width": 936,
                "height": 70,
                "fontSize": 38,
                "fontWeight": 600,
                "color": "#edf2f7",
                "textAlign": "center"
              }
            }
          ]
        }
      }
    ]
  }
}
