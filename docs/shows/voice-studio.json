                  "#c5b2ff"
                ],
                "speed": 1,
                "intensity": 1,
                "scale": 1,
                "opacity": 1,
                "radius": 20,
                "quality": "medium",
                "clock": "show"
              }
            },
            {
              "id": "title",
              "type": "text",
              "text": {
                "get": "values.title"
              },
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 90,
                "width": 936,
                "height": 110,
                "fontSize": 62,
                "fontWeight": 600,
                "color": "#edf2f7"
              }
            },
            {
              "id": "host-camera",
              "type": "slot",
              "slotId": "host",
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 270,
                "width": 936,
                "height": 1000
              },
              "framing": {
                "mode": "fill",
                "x": 0.5,
                "y": 0.5
              },
              "appearance": {
                "shape": "rectangle",
                "cornerRadius": 28,
                "outlineWidth": 2,
                "outlineColor": "#344455",
                "grayscale": 0,
                "opacity": 1
              }
            },
            {
              "id": "voice-subtitle",
              "type": "text",
              "text": "MICROPHONE BUS",
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 1625,
                "width": 936,
                "height": 65,
                "fontSize": 28,
                "fontWeight": 600,
                "color": "#62e5d5"
              }
            },
            {
              "id": "voice-description",
              "type": "text",
              "text": "Speak. Let the room move.",
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 1710,
                "width": 936,
                "height": 70,
                "fontSize": 38,
                "fontWeight": 600,
                "color": "#edf2f7"
              }
            },
            {
              "id": "source-note",
              "type": "text",
              "text": "Level-reactive bars \u00b7 not a PCM waveform",
              "styles": {
                "position": "absolute",
                "left": 72,
                "top": 1810,
                "width": 936,
