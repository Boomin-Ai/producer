+bool gs_try_stage_textures(gs_stagesurf_t *const *destinations, gs_texture_t *const *sources, size_t count)
+{
+	graphics_t *graphics = thread_graphics;
+
+	if (count < 2 || !gs_valid("gs_try_stage_textures") || !graphics->exports.device_stage_textures)
+		return false;
+
+	return graphics->exports.device_stage_textures(graphics->device, destinations, sources, count);
+}
