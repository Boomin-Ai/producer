+++ b/producer-metal-stage-batch.swift
@@ -0,0 +1,63 @@
+import Metal
+
+// Optional libobs graphics backend export for the video output's converted
+// planes. Mapping the previous slot fences the submitted copy if necessary.
+@_cdecl("device_stage_textures")
+public func device_stage_textures(
+    device devicePointer: UnsafeRawPointer,
+    destinations: UnsafePointer<UnsafeRawPointer?>,
+    sources: UnsafePointer<UnsafeRawPointer?>,
+    count: Int
+) -> Bool {
+    guard (2...3).contains(count) else { return false }
+    let device: MetalDevice = unretained(devicePointer)
+
+    for index in 0..<count {
+        guard let sourcePointer = sources[index],
+              let destinationPointer = destinations[index] else { return false }
+        let source: MetalTexture = unretained(sourcePointer)
+        let destination: MetalStageBuffer = unretained(destinationPointer)
+        guard source.device === device, destination.device === device,
+              source.texture.width == destination.width,
+              source.texture.height == destination.height,
+              source.texture.pixelFormat == destination.format,
+              destination.format.bytesPerPixel != nil else { return false }
+    }
+
+    for index in 0..<count {
+        let destination: MetalStageBuffer = unretained(destinations[index]!)
+        destination.retireStagedVideoCopy()
+    }
+
+    do {
+        try device.ensureCommandBuffer()
+    } catch {
+        return false
+    }
+    guard let command = device.renderState.commandBuffer,
+          let encoder = command.makeBlitCommandEncoder() else { return false }
+
+    // Conversion draws already encoded into this command precede the copies.
+    for index in 0..<count {
+        let source: MetalTexture = unretained(sources[index]!)
+        let destination: MetalStageBuffer = unretained(destinations[index]!)
+        encoder.copy(
+            from: source.texture,
+            sourceSlice: 0,
+            sourceLevel: 0,
+            sourceOrigin: .init(x: 0, y: 0, z: 0),
+            sourceSize: .init(width: destination.width, height: destination.height, depth: 1),
+            to: destination.buffer,
+            destinationOffset: 0,
+            destinationBytesPerRow: destination.width * destination.format.bytesPerPixel!,
+            destinationBytesPerImage: 0
+        )
+    }
+    encoder.endEncoding()
+    device.finishPendingCommands()
+    for index in 0..<count {
+        let destination: MetalStageBuffer = unretained(destinations[index]!)
+        destination.stagedVideoCopy = command
+    }
+    return true
+}
