+
+    // The command buffer retains its textures and destination storage even
+    // when OBS destroys a slot before it is mapped.
+    func waitForStagedVideoCopy() -> Bool {
+        guard let command = stagedVideoCopy else { return true }
+        let status = command.status
+        if status != .completed && status != .error {
+            command.waitUntilCompleted()
+        }
+        return command.status == .completed
+    }
+
+    func retireStagedVideoCopy() {
+        _ = waitForStagedVideoCopy()
+        stagedVideoCopy = nil
+    }
 
