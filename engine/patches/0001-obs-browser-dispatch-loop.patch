@@ -423,3 +423,103 @@ void BrowserApp::OnScheduleMessagePumpWork(int64_t delay_ms)
 	QMetaObject::invokeMethod(&messageObject, "DoCefMessageLoop", Qt::QueuedConnection, Q_ARG(int, (int)delay_ms));
 }
 #endif
+
+#ifdef ENABLE_BROWSER_DISPATCH_LOOP
+/* Producer patch: libdispatch main-thread pump — the Qt loop above,
+ * re-expressed with GCD so a host without a QApplication can run CEF.
+ * The host's NSApplication run loop drains the main queue. */
+#include <dispatch/dispatch.h>
+
+namespace {
+struct DispatchTask {
+	CefRefPtr<CefBrowser> browser;
+	BrowserFunc func;
+};
+
+std::mutex browserTaskMutex;
+std::deque<DispatchTask> browserTasks;
+
+void execute_next_browser_task_f(void *)
+{
+	ExecuteNextBrowserTask();
+}
+
+void cef_do_work_f(void *)
+{
+	CefDoMessageLoopWork();
+}
+
+void execute_message_task_f(void *param)
+{
+	MessageTask *task = static_cast<MessageTask *>(param);
+	(*task)();
+	delete task;
+}
+
+dispatch_source_t frame_timer = nullptr;
+
+/* only ever called on the main queue, so creation is race-free */
+void ensure_frame_timer_f(void *)
+{
+	if (frame_timer)
+		return;
+	frame_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+	dispatch_source_set_timer(frame_timer, DISPATCH_TIME_NOW, 33ull * NSEC_PER_MSEC, 4ull * NSEC_PER_MSEC);
+	dispatch_source_set_event_handler_f(frame_timer, cef_do_work_f);
+	dispatch_resume(frame_timer);
+}
+} // namespace
+
+bool ExecuteNextBrowserTask()
+{
+	DispatchTask nextTask;
+	{
+		std::lock_guard<std::mutex> lock(browserTaskMutex);
+		if (!browserTasks.size())
+			return false;
+
+		nextTask = browserTasks[0];
+		browserTasks.pop_front();
+	}
+
+	nextTask.func(nextTask.browser);
+	return true;
+}
+
+void QueueBrowserTask(CefRefPtr<CefBrowser> browser, BrowserFunc func)
+{
+	{
+		std::lock_guard<std::mutex> lock(browserTaskMutex);
+		browserTasks.push_back({browser, func});
+	}
+	dispatch_async_f(dispatch_get_main_queue(), nullptr, execute_next_browser_task_f);
+}
+
+void ExecuteTaskOnMain(MessageTask task)
+{
+	dispatch_async_f(dispatch_get_main_queue(), new MessageTask(std::move(task)), execute_message_task_f);
+}
+
+void ProcessCef()
+{
+	dispatch_async_f(dispatch_get_main_queue(), nullptr, cef_do_work_f);
+}
+
+#define MAX_DELAY (1000 / 30)
+
+#if CHROME_VERSION_BUILD < 5938
+void BrowserApp::OnScheduleMessagePumpWork(int64 delay_ms)
+#else
+void BrowserApp::OnScheduleMessagePumpWork(int64_t delay_ms)
+#endif
+{
+	if (delay_ms < 0)
+		delay_ms = 0;
+	else if (delay_ms > MAX_DELAY)
+		delay_ms = MAX_DELAY;
+
+	dispatch_async_f(dispatch_get_main_queue(), nullptr, ensure_frame_timer_f);
+	dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay_ms + 2) * NSEC_PER_MSEC),
+			 dispatch_get_main_queue(), nullptr, cef_do_work_f);
+}
+#endif
