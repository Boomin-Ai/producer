+++ b/pkg/sfu/buffer/lab_sr_request.go
@@ -0,0 +1,38 @@
+package buffer
+
+// Opt-in experiment: at most three requests, 250 ms apart, during the first
+// second of an audio SSRC. Called under the existing Buffer lock, with no timer
+// or goroutine. A received report or expiry permanently retires the policy.
+type labSRRequest struct {
+	enabled bool
+	started bool
+	first   int64
+	last    int64
+	count   int
+}
+
+func (r *labSRRequest) take(now int64, hasReport bool) bool {
+	if !r.enabled {
+		return false
+	}
+	if hasReport {
+		r.enabled = false
+		return false
+	}
+	if !r.started {
+		r.started = true
+		r.first = now
+	} else if now < r.last {
+		return false
+	}
+	if now-r.first >= 1_000_000_000 || r.count >= 3 {
+		r.enabled = false
+		return false
+	}
+	if r.count > 0 && now-r.last < 250_000_000 {
+		return false
+	}
+	r.last = now
+	r.count++
+	return true
+}
