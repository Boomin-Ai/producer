@@ -0,0 +1,34 @@
+package buffer
+
+import "testing"
+
+func TestLabSRRequestBoundAndRetirement(t *testing.T) {
+	r := labSRRequest{enabled: true}
+	for _, tt := range []struct {
+		now  int64
+		want bool
+	}{
+		{0, true}, {1, false}, {249_999_999, false}, {250_000_000, true},
+		{249_000_000, false}, {500_000_000, true}, {750_000_000, false},
+		{2_000_000_000, false},
+	} {
+		if got := r.take(tt.now, false); got != tt.want {
+			t.Fatalf("%d: got %v want %v", tt.now, got, tt.want)
+		}
+	}
+	if r.count != 3 || r.enabled {
+		t.Fatal("Request budget did not retire")
+	}
+	r = labSRRequest{enabled: true}
+	if !r.take(0, false) || r.take(1_000_000_000, false) || r.enabled {
+		t.Fatal("Expired policy did not retire")
+	}
+	r = labSRRequest{enabled: true}
+	if !r.take(0, false) || r.take(100_000_000, true) || r.take(500_000_000, false) {
+		t.Fatal("Received report did not retire policy")
+	}
+	r = labSRRequest{}
+	if r.take(0, false) || r.count != 0 {
+		t.Fatal("Disabled policy emitted a request")
+	}
+}
