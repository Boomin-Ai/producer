+
+func TestLabDelayedSRRequest(t *testing.T) {
+	r := labSRRequest{enabled: true, delayed: true}
+	for _, tt := range []struct {
+		now  int64
+		want bool
+	}{
+		{10, false}, {499_999_999, false}, {500_000_010, true},
+		{750_000_010, false}, {1_000_000_010, false},
+	} {
+		if got := r.take(tt.now, false); got != tt.want {
+			t.Fatalf("%d: got %v want %v", tt.now, got, tt.want)
+		}
+	}
+	if r.count != 1 || r.enabled {
+		t.Fatal("One-shot request did not retire")
+	}
+	r = labSRRequest{enabled: true, delayed: true}
+	if r.take(0, false) || r.take(1_000_000_000, false) || r.enabled {
+		t.Fatal("Expired delayed request emitted")
+	}
+	r = labSRRequest{enabled: true, delayed: true}
+	if r.take(0, false) || r.take(100_000_000, true) || r.take(600_000_000, false) || r.enabled {
+		t.Fatal("Received report did not retire delayed policy")
+	}
+	r = labSRRequest{enabled: true, delayed: true}
+	if r.take(100, false) || r.take(99, false) || r.count != 0 {
+		t.Fatal("Regressed clock emitted")
+	}
+}
