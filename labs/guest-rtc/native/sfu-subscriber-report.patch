+// Called only after the new audio downtrack forwards its first packet. Snapshot
+// buffers without retaining subscriber references or holding locks across layers.
+func (r *ReceiverBase) LabArmSubscriberSenderReport() {
+	if r.params.Kind != webrtc.RTPCodecTypeAudio {
+		return
+	}
+	r.bufferMu.RLock()
+	buffers := r.buffers
+	r.bufferMu.RUnlock()
+	for _, buff := range buffers {
+		if requester, ok := buff.(interface{ LabArmSubscriberSenderReport() }); ok {
+			requester.LabArmSubscriberSenderReport()
+		}
+	}
+}
