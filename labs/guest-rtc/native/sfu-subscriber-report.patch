+package rtc
+
+import (
+	"github.com/livekit/livekit-server/pkg/sfu"
+	"sync/atomic"
+	"testing"
+)
+
+type labSRReceiverProbe struct {
+	sfu.TrackReceiver
+	calls atomic.Int32
+}
+
+func (p *labSRReceiverProbe) LabArmSubscriberSenderReport() { p.calls.Add(1) }
+func TestLabSubscriberRequestTraversesReceiverViews(t *testing.T) {
+	primary := &labSRReceiverProbe{}
+	other := &labSRReceiverProbe{}
+	selected := &simulcastReceiver{TrackReceiver: primary}
+	dummy := &DummyReceiver{}
+	dummy.receiver.Store(sfu.TrackReceiver(selected))
+	wrapped := &WrappedReceiver{TrackReceiver: dummy}
+	wrapped.LabArmSubscriberSenderReport()
+	if primary.calls.Load() != 1 {
+		t.Fatal("selected wrapper swallowed request")
+	}
+	selected.lock.Lock()
+	selected.regressTo = other
+	selected.lock.Unlock()
+	wrapped.LabArmSubscriberSenderReport()
+	if primary.calls.Load() != 1 || other.calls.Load() != 1 {
+		t.Fatal("request did not follow regression")
+	}
+	red := &DummyRedReceiver{DummyReceiver: dummy}
+	red.redReceiver.Store(sfu.TrackReceiver(primary))
+	red.LabArmSubscriberSenderReport()
+	if primary.calls.Load() != 2 {
+		t.Fatal("RED view swallowed request")
+	}
+	// Not-yet-upgraded views have no source to arm, and must not panic or allocate.
+	(&WrappedReceiver{}).LabArmSubscriberSenderReport()
+	(&DummyReceiver{}).LabArmSubscriberSenderReport()
+	(&DummyRedReceiver{}).LabArmSubscriberSenderReport()
+}
