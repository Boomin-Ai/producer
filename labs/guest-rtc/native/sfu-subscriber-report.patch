+package buffer
+
+import (
+	"github.com/pion/rtcp"
+	"github.com/pion/webrtc/v4"
+	"testing"
+)
+
+func TestSubscriberBufferAdmissionBeforeBind(t *testing.T) {
+	t.Setenv("LIVEKIT_LAB_SUBSCRIBER_AUDIO_SR", "1")
+	t.Setenv("LIVEKIT_LAB_DELAYED_AUDIO_SR", "1")
+	b := NewBuffer(123, 100, 100)
+	b.LabArmSubscriberSenderReport()
+	if !b.labSubscriberReportRequest.active || b.labReportRequest.enabled {
+		t.Fatal("pending admission or old-policy exclusivity")
+	}
+	codec := webrtc.RTPCodecParameters{RTPCodecCapability: webrtc.RTPCodecCapability{MimeType: "audio/opus", ClockRate: 48000}, PayloadType: 111}
+	if err := b.Bind(webrtc.RTPParameters{Codecs: []webrtc.RTPCodecParameters{codec}}, codec.RTPCodecCapability, 0); err != nil {
+		t.Fatal(err)
+	}
+	defer b.Close()
+	first := b.labSubscriberReportRequest.first
+	b.Lock()
+	packets := b.getRTCPPackets(first + 500_000_000)
+	b.Unlock()
+	requests := 0
+	for _, packet := range packets {
+		if r, ok := packet.(*rtcp.RapidResynchronizationRequest); ok {
+			requests++
+			if r.MediaSSRC != 123 {
+				t.Fatal("request escaped publisher SSRC")
+			}
+		}
+	}
+	if requests != 1 {
+		t.Fatalf("expected single request after bind, got %d", requests)
+	}
+}
+
+func TestSubscriberBufferDefaultAndVideoDoNotRequest(t *testing.T) {
+	for _, video := range []bool{false, true} {
+		t.Setenv("LIVEKIT_LAB_SUBSCRIBER_AUDIO_SR", "0")
+		t.Setenv("LIVEKIT_LAB_DELAYED_AUDIO_SR", "0")
+		t.Setenv("LIVEKIT_LAB_EARLY_AUDIO_SR", "0")
+		if video {
+			t.Setenv("LIVEKIT_LAB_SUBSCRIBER_AUDIO_SR", "1")
+		}
+		b := NewBuffer(123, 100, 100)
+		b.LabArmSubscriberSenderReport()
+		codec := webrtc.RTPCodecParameters{RTPCodecCapability: webrtc.RTPCodecCapability{MimeType: "audio/opus", ClockRate: 48000}, PayloadType: 111}
+		if video {
+			codec.MimeType = "video/vp8"
+			codec.ClockRate = 90000
+			codec.PayloadType = 96
+		}
+		if err := b.Bind(webrtc.RTPParameters{Codecs: []webrtc.RTPCodecParameters{codec}}, codec.RTPCodecCapability, 0); err != nil {
+			t.Fatal(err)
+		}
+		b.Lock()
+		packets := b.getRTCPPackets(b.labSubscriberReportRequest.first + 500_000_000)
+		b.Unlock()
+		for _, packet := range packets {
+			if _, ok := packet.(*rtcp.RapidResynchronizationRequest); ok {
+				t.Fatal("default/video emitted audio timing request")
+			}
+		}
+		b.Close()
+	}
+}
