+package buffer
+
+import "testing"
+
+func TestSubscriberDelayedAndFreshReport(t *testing.T) {
+	r := labSubscriberSRRequest{enabled: true}
+	if !r.arm(0, 100) || r.take(249_999_999, 100) || !r.take(250_000_000, 100) {
+		t.Fatal("admission delay")
+	}
+	if r.take(600_000_000, 101) || r.active || r.take(800_000_000, 101) {
+		t.Fatal("fresh report did not retire")
+	}
+	if !r.arm(900_000_000, 101) || r.take(1_149_999_999, 101) || !r.take(1_150_000_000, 101) {
+		t.Fatal("readmission did not rearm")
+	}
+}
+func TestSubscriberCachedAndRegressedReportsDoNotRetire(t *testing.T) {
+	r := labSubscriberSRRequest{enabled: true}
+	r.arm(0, 100)
+	if !r.take(250_000_000, 100) || r.take(300_000_000, 99) || !r.take(500_000_000, 100) {
+		t.Fatal("old cached report")
+	}
+	if r.take(499_000_000, 101) {
+		t.Fatal("clock regression")
+	}
+}
+func TestSubscriberBudgetCoalescesAdmissionStorm(t *testing.T) {
+	r := labSubscriberSRRequest{enabled: true}
+	r.arm(0, 0)
+	emitted := 0
+	for now := int64(0); now < 2_000_000_000; now += 10_000_000 {
+		r.arm(now, 0)
+		if r.take(now, 0) {
+			emitted++
+		}
+	}
+	if emitted != 3 || r.arm(1_999_999_999, 0) {
+		t.Fatalf("unbounded admission requests %d", emitted)
+	}
+	if !r.arm(2_000_000_000, 0) || !r.take(2_250_000_000, 0) {
+		t.Fatal("new budget window")
+	}
+}
+func TestSubscriberDeadlineNotExtendedByAdmission(t *testing.T) {
+	r := labSubscriberSRRequest{enabled: true}
+	r.arm(0, 0)
+	r.arm(1_900_000_000, 1)
+	if r.take(2_000_000_000, 1) || r.active {
+		t.Fatal("admission extended deadline")
+	}
+}
+func TestSubscriberDisabledAndRegressedAdmission(t *testing.T) {
+	r := labSubscriberSRRequest{}
+	if r.arm(0, 0) || r.take(250_000_000, 0) {
+		t.Fatal("disabled requested")
+	}
+	r.enabled = true
+	r.arm(100, 1)
+	if r.arm(99, 2) || r.baselineNTP != 1 {
+		t.Fatal("regressed arm changed state")
+	}
+}
+func TestSubscriberEarlyReportStillRequestsAfterDelay(t *testing.T) {
+	r := labSubscriberSRRequest{enabled: true}
+	r.arm(0, 0)
+	if r.take(100_000_000, 5) || !r.take(250_000_000, 5) || r.baselineNTP != 5 {
+		t.Fatal("early report suppressed post-admission request")
+	}
+}
+func TestSubscriberExpiryAndRepeatedRecovery(t *testing.T) {
+	r := labSubscriberSRRequest{enabled: true}
+	for cycle := int64(0); cycle < 100; cycle++ {
+		start := cycle * 3_000_000_000
+		if !r.arm(start, uint64(cycle)) || !r.take(start+250_000_000, uint64(cycle)) {
+			t.Fatal("recovery failed")
+		}
+		if r.take(start+600_000_000, uint64(cycle+1)) || r.active {
+			t.Fatal("recovery not retired")
+		}
+	}
+	r.arm(301_000_000_000, 101)
+	if r.take(303_000_000_000, 101) || r.active {
+		t.Fatal("expiry")
+	}
+}
