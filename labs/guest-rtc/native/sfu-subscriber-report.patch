+package buffer
+
+// Packet-driven, bounded per-publisher policy. Caller holds the existing Buffer
+// lock. Admissions share a three-request/two-second budget; coalescing does not
+// extend the active deadline. No timers, goroutines or subscriber references.
+type labSubscriberSRRequest struct {
+	enabled       bool
+	active        bool
+	windowStarted bool
+	windowStart   int64
+	first         int64
+	lastObserved  int64
+	lastRequest   int64
+	baselineNTP   uint64
+	spent         int
+	sentSinceArm  bool
+}
+
+func (r *labSubscriberSRRequest) arm(now int64, ntp uint64) bool {
+	if !r.enabled || (r.windowStarted && now < r.lastObserved) {
+		return false
+	}
+	if !r.windowStarted || now-r.windowStart >= 2_000_000_000 {
+		r.windowStarted = true
+		r.windowStart = now
+		r.spent = 0
+	}
+	if r.spent >= 3 {
+		return false
+	}
+	if !r.active || now-r.first >= 2_000_000_000 {
+		r.first = now
+		r.active = true
+	}
+	r.lastObserved = now
+	r.baselineNTP = ntp
+	r.sentSinceArm = false
+	return true
+}
+
+func (r *labSubscriberSRRequest) take(now int64, ntp uint64) bool {
+	if !r.active || now < r.lastObserved {
+		return false
+	}
+	r.lastObserved = now
+	if now-r.first >= 2_000_000_000 || r.spent >= 3 || (r.sentSinceArm && ntp > r.baselineNTP) {
+		r.active = false
+		return false
+	}
+	if now-r.first < 250_000_000 || (r.spent > 0 && now-r.lastRequest < 250_000_000) {
+		return false
+	}
+	r.spent++
+	r.lastRequest = now
+	r.sentSinceArm = true
+	// Only a report newer than this request's snapshot can retire the request.
+	r.baselineNTP = ntp
+	return true
+}
