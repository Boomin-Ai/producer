+// Arm only the opt-in audio policy, under the buffer lock. The buffer already
+// owns the publisher SSRC and report state. No old report is installed downstream.
+func (b *Buffer) LabArmSubscriberSenderReport() {
+	b.Lock()
+	defer b.Unlock()
+	if !b.labSubscriberReportRequest.enabled {
+		return
+	}
+	var ntp uint64
+	if b.rtpStats != nil {
+		if sr := b.rtpStats.GetRtcpSenderReportData(); sr != nil {
+			ntp = sr.NtpTimestamp
+		}
+	}
+	b.labSubscriberReportRequest.arm(mono.UnixNano(), ntp)
