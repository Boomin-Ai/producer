@@ -0,0 +1,14 @@
+// Isolated G1 diagnostic experiment. Default upstream cadence is unchanged.
+package rtc
+
+import (
+	"os"
+	"time"
+)
+
+func labSenderReportInterval() time.Duration {
+	if os.Getenv("LIVEKIT_LAB_FAST_RTCP") == "1" {
+		return 250 * time.Millisecond
+	}
+	return 3 * time.Second
+}
