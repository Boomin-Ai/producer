+++ b/pkg/rtc/lab_sender_report_interval_test.go
@@ -0,0 +1,18 @@
+package rtc
+
+import (
+	"testing"
+	"time"
+)
+
+func TestLabSenderReportCadenceIsOptIn(t *testing.T) {
+	for _, test := range []struct {
+		value string
+		want  time.Duration
+	}{{"", 3 * time.Second}, {"0", 3 * time.Second}, {"bad", 3 * time.Second}, {"1", 250 * time.Millisecond}} {
+		t.Setenv("LIVEKIT_LAB_FAST_RTCP", test.value)
+		if got := labSenderReportInterval(); got != test.want {
+			t.Fatalf("%q cadence %v, want %v", test.value, got, test.want)
+		}
+	}
+}
