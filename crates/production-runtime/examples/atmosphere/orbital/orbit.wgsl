// Full-frame procedural weather artwork. This is an abstract field, not radar.
let p=(uv-center)*vec2<f32>(aspect,1.0)/radius;
let r=length(p);
let normal=normalize(vec3<f32>(p.x,-p.y,sqrt(max(0.0001,1.0-r*r))));
let lat=asin(clamp(normal.y,-1.,1.));
let lon=atan2(normal.x,normal.z)+t*0.026+radians(frame.params.z)*0.32;
let tilt=radians(frame.params.w)*0.7;
let light=normalize(vec3<f32>(0.74,0.52+0.22*sin(tilt),0.18));
let day=clamp(dot(normal,light)*1.40+0.14,0.0,1.0);
let heat=clamp((frame.params.x+12.0)/50.0,0.,1.);
let ink=mix(vec3<f32>(0.05,0.78,0.82),vec3<f32>(0.22,0.80,0.50),heat);
let sun=vec3<f32>(1.0,0.60,0.25);
let field=lat*2.8+0.80*sin(lon*4.1+sin(lat*3.0)-t*0.09)+0.35*cos(lon*7.0-lat*4.2+t*0.11)+0.19*sin(lon*11.0+lat*6.0);
let stripe=field*4.0;
let contour=1.0-smoothstep(0.018,max(0.042,min(0.28,fwidth(stripe)*1.15)),abs(fract(stripe+.5)-.5));
let mer=lon*3.82;let par=lat*5.73;
let grid=max(1.-smoothstep(.010,.032,abs(fract(mer+.5)-.5)),1.-smoothstep(.010,.032,abs(fract(par+.5)-.5)));
let oceans=mix(vec3<f32>(0.015,0.055,0.105),ink*.48,.5+.5*sin(field*2.7));
let edge=exp(-abs(r-1.)*105.);
let dusk=clamp(0.50+0.65*dot(normal,light),0.,1.);
let polar=pow(max(0.,1.-normal.z),3.0);
let terrain=oceans*(.25+day*.82)+ink*(.16*grid+.60*contour)*(.28+day*.72)+sun*polar*dusk*.74;
let space=vec3<f32>(.018,.037,.067)+vec3<f32>(.025,.09,.12)*exp(-abs(r-1.)*5.);
let cell=floor(position.xy/3.);
let speck=fract(sin(dot(cell,vec2<f32>(12.113,35.71)))*3791.71);
let stars=smoothstep(.9975,1.,speck)*.42;
let angle=atan2(p.y,p.x);
let orbit=exp(-abs(r-1.075)*330.)*.44+exp(-abs(r-1.10)*420.)*smoothstep(.35,.65,cos(angle*156.))*.46;
let bg=mix(space+vec3<f32>(stars),terrain,1.-smoothstep(.996,1.004,r));
let horizon=mix(ink,sun,smoothstep(.25,.96,dusk));
let flare=exp(-length(p-vec2<f32>(.72,-.70))*13.0)*.49;
return vec4<f32>(bg+horizon*(edge+orbit+flare),1.);
