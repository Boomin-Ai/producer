let env=textureSample(input0,linear_sampler,uv).rgb;
let mask=1.-smoothstep(1.-1.3*pixel,1.+1.3*pixel,r);
let z=sqrt(max(0.,1.-r*r));
let n=normalize(vec3<f32>(p.x,-p.y,max(.0001,z)));
let crop=vec2<f32>(min(1.,sourceBox.w*frame.info.y/(sourceBox.z*frame.info.x)),min(1.,sourceBox.z*frame.info.x/(sourceBox.w*frame.info.y)));
let glassUV=.5+.5*p*crop*(.92+.08*smoothstep(.58,1.,r));
let cam=textureSample(input1,linear_sampler,sourceBox.xy+sourceBox.zw*clamp(glassUV,vec2<f32>(0.),vec2<f32>(1.)));
let k=normalize(vec3<f32>(-.55,.6,.63));
let rim=pow(1.-z,2.7);
let shine=pow(max(dot(n,k),0.),38.);
let coating=mix(jade,vec3<f32>(.63,.45,.82),.5+.5*sin(atan2(p.y,p.x)*2.+t*.09));
let own=cam.rgb+coating*(rim*.54+.018)+gold*shine*.14;
let disk=mix(env,own,mask);
let d=(length(ellipse)-1.)/max(length(normalize(ellipse+vec2<f32>(.00001))/axes),.001);
let angle=atan2(ellipse.y,ellipse.x);
let width=.021+.009*(.5+.5*sin(angle));
let ring=1.-smoothstep(width-pixel,width+pixel,abs(d));
let front=smoothstep(-.07,.07,ellipse.y);
let visible=1.-mask*(1.-front);
let metal=mix(jade*.44,gold,.5+.5*cos(angle-.90));
let groove=.46+.53*cos(d/width*2.2);
let chase=pow(.5+.5*cos(angle-t*.50),19.);
let shadow=exp(-abs(d-.045)*32.)*front*mask;
let rail=mix(disk*(1.-.28*shadow),metal*(groove+.40*chase),ring*visible);
let inner=exp(-abs(d+.032)*150.)*visible;
return vec4<f32>(rail+gold*inner*.22,1.);
