// World-space markings are drawn into the ground plane and stay fixed while the shot moves.
let x=(uv.x-.5)*240.;
let z=(uv.y-.5)*320.-65.;
let road=abs(x);
let junction=abs(fract((z+4.)/22.+.5)-.5)*22.;
let crossStreet=1.-smoothstep(3.3,3.55,junction);
let otherStreet=abs(fract(x/31.+.5)-.5)*31.;
let mainStreet=1.-smoothstep(4.65,4.78,otherStreet);
let asphalt=max(mainStreet,crossStreet);
let stone=vec3<f32>(.19,.215,.235);
let lane=vec3<f32>(.047,.079,.103);
let seams=step(.95,fract(z*.8))+step(.95,fract(x*.75));
var rgb=mix(stone*(1.-.11*seams),lane,asphalt);
let dash=step(.47,fract(z/4.5))*(1.-smoothstep(.035,.09,abs(road-2.56)));
let median=1.-smoothstep(.035,.10,abs(road-.14));
let curb=exp(-16.*abs(road-4.70));
let zebra=(1.-smoothstep(.70,.83,abs(junction-4.72)))*step(.43,fract((x+5.)*1.18))*mainStreet;
rgb+=(dash*.49+median*.57)*(1.-crossStreet)*vec3<f32>(.85,.74,.45)+zebra*vec3<f32>(.61,.65,.63)+curb*.3;
let reflection=.52+.48*sin(x*34.+.75*sin(z*1.7)+sin(z*3.4));
let lot=floor(vec2<f32>(x/8.,z/11.));
let seed=fract(sin(dot(lot,vec2<f32>(31.712,74.219)))*14235.4);
let rooflot=smoothstep(6.,8.,otherStreet)*smoothstep(4.8,6.,junction);
rgb=mix(rgb,mix(vec3<f32>(.13,.15,.17),vec3<f32>(.31,.29,.25),seed),rooflot);
rgb+=asphalt*reflection*(.045+.12*exp(-.65*abs(road-3.8)))*mix(vec3<f32>(.33,.68,.77),vec3<f32>(.91,.46,.22),step(0.,x));
let dir=select(-1.,1.,x>0.);
let travel=fract((z-dir*frame.info.z*3.4+dir*4.5)/24.+.5)-.5;
let body=vec2<f32>(road-1.42,travel*24.);
let car=(1.-smoothstep(.49,.60,abs(body.x)))*(1.-smoothstep(1.03,1.18,abs(body.y)));
rgb=mix(rgb,mix(vec3<f32>(.46,.20,.11),vec3<f32>(.13,.31,.34),step(0.,x)),car);
let bulbs=exp(-9.*abs(abs(body.x)-.38));
rgb+=bulbs*(exp(-9.*abs(body.y-dir)) * vec3<f32>(1.,.92,.79)+ exp(-10.*abs(body.y+dir))*vec3<f32>(.94,.14,.04));
let haze=smoothstep(60.,180.,length(vec2<f32>(x,z+20.)));
return vec4<f32>(mix(rgb,vec3<f32>(.26,.28,.33),haze*.79),1.);
